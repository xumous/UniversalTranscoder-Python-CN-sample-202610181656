<?xml version="1.0" encoding="utf-8"?>
<!-- 关于页布局：顶部工具栏（含返回箭头）+ 身份卡片与三张说明卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical">

    <!-- 工具栏：展示页面标题并提供返回入口。 -->
    <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/brand_primary"
            app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
            app:title="@string/about_title"
            app:titleTextColor="#FFFFFF"/>

    <!-- 可滚动内容区。 -->
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

        <!-- 页面内容容器。 -->
        <LinearLayout
                style="@style/PageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- 卡片：图标与身份信息。 -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="1dp">

                <!-- 内容容器：居中展示。 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                    <!-- 应用图标（自适应图标资源）。 -->
                    <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:contentDescription="@string/app_name"
                            android:src="@mipmap/ic_launcher"/>

                    <!-- 应用名称。 -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_small"
                            android:text="@string/app_name"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    <!-- 版本号行。 -->
                    <TextView
                            android:id="@+id/txt_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"/>

                    <!-- 作者行。 -->
                    <TextView
                            android:id="@+id/txt_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片：离线说明。 -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_between"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="1dp">

                <!-- 内容容器。 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                    <!-- 标题。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_offline_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <!-- 正文。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_offline_body"
                            android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片：转换引擎说明。 -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_between"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="1dp">

                <!-- 内容容器。 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                    <!-- 标题。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_engine_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <!-- 正文。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_engine_body"
                            android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片：容器支持范围说明（诚实标注限制）。 -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_between"
                    app:cardCornerRadius="@dimen/card_radius"
                    app:cardElevation="1dp">

                <!-- 内容容器。 -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                    <!-- 标题。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_support_title"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>

                    <!-- 正文。 -->
                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_support_body"
                            android:textColor="@color/text_secondary"/>

                    <!-- 实际探测结果：运行时填充，展示本设备支持的容器清单。 -->
                    <TextView
                            android:id="@+id/txt_support_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_small"
                            android:fontFamily="monospace"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
