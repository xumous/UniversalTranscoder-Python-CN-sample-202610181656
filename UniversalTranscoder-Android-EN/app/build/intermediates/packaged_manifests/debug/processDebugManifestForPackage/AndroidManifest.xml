<?xml version="1.0" encoding="utf-8"?>
<!-- 应用清单文件：声明包信息、组件、图标与启动入口。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.xu.universaltranscoder"
          android:versionCode="1"
          android:versionName="1.0.0">

    <uses-sdk
            android:minSdkVersion="28"
            android:targetSdkVersion="28"/>

    <permission
            android:name="com.xu.universaltranscoder.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
            android:protectionLevel="signature"/>

    <uses-permission android:name="com.xu.universaltranscoder.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <!--
 说明：本应用完全离线，通过 SAF(Storage Access Framework) 让用户按需授权单个文件/目录，
         因此不需要声明任何存储权限，也就不存在运行时权限弹窗，这符合“离线工具”的最小权限原则。
    -->
    <application
            android:allowBackup="true"
            android:appComponentFactory="androidx.core.app.CoreComponentFactory"
            android:debuggable="true"
            android:extractNativeLibs="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.UniversalTranscoder">

        <!-- MainActivity：唯一的启动入口，内部用 TabLayout + ViewPager2 承载 5 个功能页。 -->
        <activity
                android:name="com.xu.universaltranscoder.MainActivity"
                android:configChanges="orientation|screenSize|keyboardHidden"
                android:exported="true">
            <intent-filter>

                <!-- MAIN + LAUNCHER 组合表示应用图标入口。 -->
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- SettingsActivity：并发数、默认输出目录、日志级别、硬件加速开关等配置页。 -->
        <activity
                android:name="com.xu.universaltranscoder.ui.SettingsActivity"
                android:exported="false"
                android:label="@string/settings_title"/>

        <!-- AboutActivity：应用名、版本、作者与离线说明。 -->
        <activity
                android:name="com.xu.universaltranscoder.ui.AboutActivity"
                android:exported="false"
                android:label="@string/about_title"/>

        <provider
                android:name="androidx.startup.InitializationProvider"
                android:authorities="com.xu.universaltranscoder.androidx-startup"
                android:exported="false">
            <meta-data
                    android:name="androidx.emoji2.text.EmojiCompatInitializer"
                    android:value="androidx.startup"/>
            <meta-data
                    android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                    android:value="androidx.startup"/>
            <meta-data
                    android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                    android:value="androidx.startup"/>
        </provider>

        <receiver
                android:name="androidx.profileinstaller.ProfileInstallReceiver"
                android:directBootAware="false"
                android:enabled="true"
                android:exported="true"
                android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION"/>
            </intent-filter>
        </receiver>
    </application>

</manifest>