    <!-- 关于页文案。 -->
    <string name="about_title">About</string>
    <string name="about_version_label">Version</string>
    <string name="about_author_label">Author</string>
    <string name="about_author_value">Xu</string>
    <string name="about_offline_title">Offline by design</string>
    <string name="about_offline_body">Universal Transcoder performs every conversion on your device using Android system
        media APIs. No network connection is required and no data ever leaves your phone.
    </string>
    <string name="about_engine_title">Conversion engine</string>
    <string name="about_engine_body">Video remux and transcode use MediaExtractor, MediaCodec and MediaMuxer. Audio
        remux and AAC encoding use the same pipeline. Image conversion uses BitmapFactory and Bitmap.compress. Documents
        use PdfDocument and PdfRenderer. Frame extraction uses MediaMetadataRetriever.
    </string>
    <string name="about_support_title">Container support</string>
    <string name="about_support_body">Available output containers depend on what the current device MediaMuxer
        implementation accepts. The app probes the device at runtime and only lists targets that are actually supported.
    </string>

